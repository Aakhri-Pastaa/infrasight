# Authored on Windows, built/run on Linux — force LF so Go tooling and shell
# scripts behave identically everywhere.
* text=auto eol=lf

*.go   text eol=lf
*.sh   text eol=lf
*.mod  text eol=lf
*.sum  text eol=lf
Makefile text eol=lf

# Treat the embedded web assets as binary-ish (no eol munging).
*.png binary
*.ico binary

# Vendored, minified third-party bundle — don't munge EOLs, don't count toward
# GitHub language stats.
internal/output/html/assets/vis-network.min.js -text linguist-vendored
