# Build artifacts (anchored to repo root so the cmd/infrasight/ package dir is
# NOT ignored)
/bin/
/dist/
/infrasight
/infrasight.exe

# Scan output (generated, not source)
/infrasight.json
/infrasight.html
/infrasight.svg
*.scan.json

# Local runtime / cache
.infrasight/
/coverage.out
*.test

# Local test fixtures (may contain generated keys/certs) — never commit
/.fixture/

# Local planning / review notes — kept on disk, not part of the repo
/infrasight_analysis_backlog.md

# Frontend (web/) — commit source, not deps or build output
/web/node_modules/
/web/dist/

# Editor / OS cruft
.idea/
.vscode/
.DS_Store
Thumbs.db
